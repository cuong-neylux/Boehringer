FUNCTION y_te_fi_split_posting_document.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IV_DOCUMENT_TYPE) TYPE  CTE_FIN_POST_DOC_TYPE
*"     REFERENCE(IS_DOCUMENT_DATA) TYPE  CTE_S_FIN_POST_DOCUMENT
*"  CHANGING
*"     REFERENCE(CT_ACC_DOCUMENTS) TYPE  CTE_T_FIN_POST_ACC_SPLITS
*"----------------------------------------------------------------------

************************************************************************
* Program name: Y_TE_FI_SPLIT_POSTING_DOCUMENT
* Purpose of program: Split FI Posting Document of Expense Report
************************************************************************
* Description:
*
* Change Log:
* Change-Number   Date       Who           Description
* 7200026780      04.09.2026 kraussie      Initial
*                                          Split post IBCP / CASH
*                                          Write Credit card number into BKPF-XBLNR for IBCP
************************************************************************



* Data declaration
  DATA lt_ibcp TYPE STANDARD TABLE OF yte_c_ibcp.
  DATA lv_compcode TYPE bukrs.
  DATA lv_has_ibcp TYPE wdy_boolean.
  DATA lt_new_split TYPE cte_t_fin_post_acc_splits.
  DATA lt_entry_rel TYPE cte_t_fin_post_entry_item_rel.
  DATA lv_payment     TYPE char10.
  DATA lv_card_token  TYPE cte_fin_post_card_account_id.
  DATA lv_card_number TYPE xblnr.
  DATA ls_accit       TYPE accit.
  DATA ls_acccr       TYPE acccr.
  DATA ls_rel         TYPE cte_s_fin_post_entry_item_rel.
  DATA lt_tokens                   TYPE cte_t_fin_post_ccard_token.
  DATA lo_cte_fnd_error_handler    TYPE REF TO cl_cte_fnd_error_handler.
  DATA lt_ccard_token              TYPE cl_cte_fin_post_ccard_services=>tt_token_cardnr_relation.
  DATA ls_ccard_token              TYPE cl_cte_fin_post_ccard_services=>ty_token_cardnr_relation.

  FIELD-SYMBOLS <fs_add_data> TYPE cte_s_additional_data.
  FIELD-SYMBOLS <fs_split_doc> TYPE cte_s_fin_post_acc_splits.
  FIELD-SYMBOLS <fs_cash_split> TYPE cte_s_fin_post_acc_splits.
  FIELD-SYMBOLS <fs_ibcp_split> TYPE cte_s_fin_post_acc_splits.
  FIELD-SYMBOLS <fs_entry> TYPE cte_s_fin_post_doc_entry.
  FIELD-SYMBOLS <fs_accrel> TYPE cte_s_fin_post_entry_item_rel.
  FIELD-SYMBOLS <fs_header> TYPE acchd.
  FIELD-SYMBOLS <fs_accit> TYPE accit.
  FIELD-SYMBOLS <fs_acccr> TYPE acccr.

************************************************************************
* Read the header level information
************************************************************************
* Read the Report Org Unit2 Code (Company Code)
  READ TABLE is_document_data-additional_data
  ASSIGNING <fs_add_data>
   WITH KEY  name = 'REPORT_ORG_UNIT2_CODE' .
  IF sy-subrc = 0 .
    lv_compcode = <fs_add_data>-value. " Company Code
  ENDIF.

************************************************************************
* Get the customizing
************************************************************************
* check if company code is customized in table IBCP
  SELECT * FROM yte_c_ibcp INTO TABLE lt_ibcp WHERE bukrs = lv_compcode.
  IF sy-subrc <> 0.
    CLEAR lt_ibcp.
  ENDIF.

************************************************************************
* Change-Number   7200026780 IBCP
* Split post IBCP / CASH
* Write Credit card number into BKPF-XBLNR for IBCP
************************************************************************
  CREATE OBJECT lo_cte_fnd_error_handler
    EXPORTING
      iv_system_key = is_document_data-system_key.

  IF lt_ibcp IS NOT INITIAL.
*    check if there is IBCP payment type code
    lv_has_ibcp = abap_false.
    LOOP AT is_document_data-entry ASSIGNING <fs_entry>.
      IF <fs_entry> IS ASSIGNED.
        READ TABLE <fs_entry>-additional_data
         ASSIGNING <fs_add_data>
        WITH KEY name = 'ENTRY_PAYMENT_TYPE_CODE' .
        IF sy-subrc = 0 AND <fs_add_data> IS ASSIGNED .
          IF <fs_add_data>-value = 'IBCP'.  "IBCP
            lv_has_ibcp = abap_true.
            EXIT.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDLOOP.

*   start to split
    IF lv_has_ibcp = abap_true.
      LOOP AT ct_acc_documents ASSIGNING <fs_split_doc>.
*       Create single documents per expense entry
        lt_entry_rel = <fs_split_doc>-acc_item_entry_rel.
        SORT lt_entry_rel BY posnr ASCENDING.
        SORT <fs_split_doc>-acd_item BY posnr.

        CLEAR: lt_new_split.
*        prepare empty lines in lt_new_split
        APPEND INITIAL LINE TO lt_new_split ASSIGNING <fs_cash_split>.
        APPEND INITIAL LINE TO lt_new_split ASSIGNING <fs_ibcp_split>.
*        Prepare ACD_HEADER
        READ TABLE <fs_split_doc>-acd_header INTO <fs_header> INDEX 1.
        IF sy-subrc = 0 AND <fs_header> IS ASSIGNED.
          APPEND <fs_header> TO <fs_cash_split>-acd_header.
          APPEND <fs_header> TO <fs_ibcp_split>-acd_header.
        ENDIF.

        LOOP AT lt_entry_rel ASSIGNING <fs_accrel>.
          IF <fs_accrel> IS ASSIGNED.
*            split EVD/EDB and CVD/CCD, there is no TAX, CAD or CAL
            IF <fs_accrel>-item_type = 'EVD' OR " Employee Vendor
            <fs_accrel>-item_type = 'EDB'.    " Employee Vendor Debit
            ELSEIF <fs_accrel>-item_type = 'CCD' OR    "Credit Card Vendor Debit
            <fs_accrel>-item_type = 'CVD'.    " Credit Card Vendor IS ASSIGNED.
            ENDIF.
* to prepare: ACD_ITEM, ACD_CURR, ACC_ITEM_ENTRY_REL
************************************************************************
*           Determine payment type and card token for this ENTRY_ID
************************************************************************
            CLEAR: lv_payment, lv_card_token.
            READ TABLE is_document_data-entry ASSIGNING <fs_entry> WITH KEY entry_id = <fs_accrel>-entry_id.

            IF sy-subrc = 0.
              lv_card_token = <fs_entry>-card_account_id.

              READ TABLE <fs_entry>-additional_data
                ASSIGNING <fs_add_data>
                WITH KEY name = 'ENTRY_PAYMENT_TYPE_CODE'.

              IF sy-subrc = 0.
                lv_payment = <fs_add_data>-value.
              ENDIF.
            ENDIF.

************************************************************************
*             Copy ACD_CURR (ACCCR)
************************************************************************
            CLEAR ls_acccr.
            READ TABLE <fs_split_doc>-acd_curr ASSIGNING <fs_acccr> WITH KEY posnr = <fs_accrel>-posnr.

            IF sy-subrc = 0.
              ls_acccr = <fs_acccr>.
              ls_acccr-posnr = ls_accit-posnr.
              IF lv_payment = 'IBCP'.
                ls_acccr-posnr = lines( <fs_ibcp_split>-acd_curr ) + 1.
                APPEND ls_acccr TO <fs_ibcp_split>-acd_curr.
              ELSE.
                ls_acccr-posnr = lines( <fs_cash_split>-acd_curr ) + 1.
                APPEND ls_acccr TO <fs_cash_split>-acd_curr.
              ENDIF.
            ENDIF.

************************************************************************
*             Copy ACC_ITEM_ENTRY_REL
************************************************************************
            ls_rel = <fs_accrel>.
            ls_rel-posnr = ls_accit-posnr.

            IF lv_payment = 'IBCP'.
              APPEND ls_rel TO <fs_ibcp_split>-acc_item_entry_rel.
            ELSE.
              APPEND ls_rel TO <fs_cash_split>-acc_item_entry_rel.
            ENDIF.

************************************************************************
*           Copy ACD_ITEM (ACCIT)
************************************************************************
            READ TABLE <fs_split_doc>-acd_item ASSIGNING <fs_accit> WITH KEY posnr = <fs_accrel>-posnr.
            IF sy-subrc = 0.
              ls_accit = <fs_accit>.

              IF lv_payment = 'IBCP'.
                ls_accit-posnr = lines( <fs_ibcp_split>-acd_item ) + 1.
                APPEND ls_accit TO <fs_ibcp_split>-acd_item.
              ELSE.
                ls_accit-posnr = lines( <fs_cash_split>-acd_item ) + 1.
                APPEND ls_accit TO <fs_cash_split>-acd_item.
              ENDIF.
            ENDIF.

************************************************************************
*             Populate BKPF-XBLNR on IBCP document
************************************************************************
            IF lv_payment = 'IBCP' AND lv_card_token IS NOT INITIAL.

* Retrieve card number from the token
              CLEAR: lt_ccard_token, lt_tokens.
              APPEND lv_card_token TO lt_tokens.
              CALL METHOD cl_cte_fin_post_ccard_services=>get_ccard_nr_from_token
                EXPORTING
                  iv_system_key    = is_document_data-system_key
                  it_ccard_tokens  = lt_tokens
                  ir_error_handler = lo_cte_fnd_error_handler
                IMPORTING
                  et_token_cardnr  = lt_ccard_token.

              IF sy-subrc = 0 AND lines( lt_ccard_token ) > 0.
                READ TABLE lt_ccard_token INTO ls_ccard_token INDEX 1.
                IF sy-subrc = 0.
                  UNASSIGN <fs_accit>.
                  READ TABLE <fs_ibcp_split>-acd_item ASSIGNING <fs_accit> WITH KEY posnr = ls_accit-posnr.
                  IF sy-subrc = 0.
                    <fs_accit>-xblnr = ls_ccard_token-cardnr.
                  ENDIF.
                ENDIF.
              ENDIF.
            ENDIF.

          ENDIF.
        ENDLOOP.
      ENDLOOP.

      REFRESH ct_acc_documents.
      APPEND LINES OF lt_new_split TO ct_acc_documents.
    ENDIF.
  ENDIF.

ENDFUNCTION.
