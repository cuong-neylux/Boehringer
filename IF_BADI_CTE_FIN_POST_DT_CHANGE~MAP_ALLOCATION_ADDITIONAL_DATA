FUNCTION y_te_fi_post_dt_chang_map_allo.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IS_ALLOCATION_DATA) TYPE  CTE_S_FIN_POST_ALLOCATION
*"  EXPORTING
*"     REFERENCE(ET_ALLOCATION_ADDITIONAL_DATA) TYPE
*"        CTE_T_ADDITIONAL_DATA
*"     REFERENCE(ET_MESSAGE) TYPE  CTE_T_T100_MSG
*"----------------------------------------------------------------------
************************************************************************
* Change-Number   Date       Who           Description
* 7200026293      13.07.2026 kraussie      Mapping additional custom allocation data from Concur to SAP table
************************************************************************

*   Local data
  DATA: lr_struc TYPE REF TO cl_abap_structdescr.
  DATA: lt_comp TYPE cl_abap_structdescr=>component_table.
  DATA: ls_allocation_additional_data TYPE cte_s_additional_data.
  FIELD-SYMBOLS <lfs_field> TYPE any.
  FIELD-SYMBOLS <fs_comp> LIKE LINE OF lt_comp.

  CLEAR: et_allocation_additional_data.
  CLEAR: et_message.

*   Get IS_ALLOCATION_DATA structure fields and data
  lr_struc ?= cl_abap_structdescr=>describe_by_data( is_allocation_data ). "Get the description IS_ALLOCATION_DATA
  lt_comp = lr_struc->get_components( ). "Get the fields of IS_ALLOCATION_DATA

*   Fill custom fields if not initial and append to export table
  LOOP AT lt_comp ASSIGNING <fs_comp>.             "#EC CI_LOOP_INTO_WA
    IF <fs_comp>-name CS 'CUSTOM'.
      ls_allocation_additional_data-name = <fs_comp>-name.
      ASSIGN COMPONENT <fs_comp>-name OF STRUCTURE is_allocation_data TO <lfs_field>.
      ls_allocation_additional_data-value = <lfs_field>.
      APPEND ls_allocation_additional_data TO et_allocation_additional_data.
      CLEAR ls_allocation_additional_data.
    ENDIF.
  ENDLOOP.

ENDFUNCTION.
